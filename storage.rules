rules_version = '2';

// Firebase Storage rules for StageReady (paste into Firebase console > Storage > Rules).
// Admins are users whose Firestore doc users/{uid} has role == "admin",
// the same check the admin site uses in AdminFirebaseService.isAdmin().
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Badge icons: anyone can view (the mobile app shows them), only admins upload or delete.
    match /badgeIcons/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Speech recordings uploaded by the mobile app; admins can list and delete them.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }
  }
}
